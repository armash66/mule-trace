# MuleTrace Environment Configuration
# Copy to .env and adjust values

# Backend
DATABASE_URL=sqlite:///./data/muletrace.db
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Feature flags
LLM_SUMMARY=false
NEO4J_ENABLED=false
STREAMING_MODE=false

# Optional: Anthropic API (only if LLM_SUMMARY=true)
ANTHROPIC_API_KEY=

# Optional: Neo4j (only if NEO4J_ENABLED=true)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Data
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
PARQUET_DIR=./data/parquet
MAX_UPLOAD_SIZE_MB=500

# Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LOCALE=en

# Seed for reproducibility
SEED=42
